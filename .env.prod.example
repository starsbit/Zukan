# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME

# Used to construct the DATABASE_URL inside docker-compose.prod.yml
POSTGRES_PASSWORD=CHANGE_ME

# Used by the updater sidecar that powers the in-app update button
UPDATER_TOKEN=CHANGE_ME

# Tagger thresholds, token expiry, OCR and rate limits can be changed in application settings.

# Twitter likes sync sidecar
ZUKAN_TOKEN=CHANGE_ME
TWITTER_AUTH_TOKEN=CHANGE_ME
TWITTER_CT0=CHANGE_ME
TWITTER_USER_ID=123456789
SHIORI_NOTIFICATION_COOLDOWN_SECONDS=21600

# Optional mounted NAS directory on the Docker host; exposed to the API at /library.
# Leave unset to retain the default auxiliary named volume.
# ZUKAN_LIBRARY_HOST_PATH=/mnt/nas/anime

# Single-owner authentication. Generate SETUP_TOKEN with openssl rand -hex 32.
# Local first-time setup requires this token; there is no default password.
AUTH_MODE=local
SETUP_TOKEN=REPLACE_WITH_RANDOM_SETUP_TOKEN
# Required for upgrades with existing accounts; use owner_migration preflight.
SINGLE_USER_OWNER_ID=
# Required only when AUTH_MODE=oidc. Use an exact issuer and immutable subject.
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=
OIDC_ALLOWED_SUBJECT=
